# NemLuxury → NemPay integration. Copy to .env (git-ignored) and fill in.
# Start the gateway first (docker-compose up inside NemPay/), then point this app at it.

# Base URL of the NemPay gateway. If NemLuxury runs in a container, use host.docker.internal.
NEMPAY_API_URL=http://localhost:8080

# Secret API key (sk_...) for server-to-server money calls. Matches NemPay's dev-seeded merchant.
# Never commit a real value; never send it to the browser.
NEMPAY_SECRET_KEY=sk_test_nempay_secret

# Shared HMAC secret for verifying inbound webhooks. MUST equal the secret NemPay is seeded with
# for this merchant's webhook endpoint (NEMPAY_DEV_WEBHOOK_SECRET on the NemPay side — task-05).
NEMPAY_WEBHOOK_SECRET=whsec_nemluxury_dev
