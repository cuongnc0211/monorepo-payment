# NemPay gateway — local dev environment. Copy to `.env` (git-ignored) and adjust as needed.
# docker-compose sets these per-service; this file documents them for local `make run`.
PORT=8080
DB_URL=postgres://nempay:nempay@localhost:5432/nempay?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# bank-sim
BANKSIM_PORT=9090

# Dev-only: register the dev merchant's webhook endpoint at boot (needs NEMPAY_DEV_SEED=1).
# The URL points at a merchant app on the host; the secret MUST match that merchant's
# NEMPAY_WEBHOOK_SECRET (e.g. NemLuxury's). Unset both to leave the standalone gateway unchanged.
NEMPAY_DEV_WEBHOOK_URL=http://host.docker.internal:3000/webhooks/nem_pay
NEMPAY_DEV_WEBHOOK_SECRET=whsec_nemluxury_dev

# Host port publishing for docker-compose (override if a port is already taken locally).
NEMPAY_PG_PORT=5432
NEMPAY_REDIS_PORT=6379
NEMPAY_API_PORT=8080
NEMPAY_BANKSIM_PORT=9090
